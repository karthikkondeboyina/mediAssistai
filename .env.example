# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DATABASE_PATH=./data/mediassist.db

# Gmail Automation Configuration (Secure App Password)
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate an App Password under "App passwords": https://myaccount.google.com/apppasswords
# 3. Add your 16-character App Password to your local .env file (DO NOT commit secrets to Git):
EMAIL_USER=karthikkondeboyina@gmail.com
EMAIL_APP_PASSWORD=your_16_digit_app_password_here

# Recipient Options
# By default, emails are dispatched to the patient's registered email address.
# For demo testing, set FORCE_TEST_RECIPIENT=true to direct all emails to TEST_EMAIL_RECIPIENT.
TEST_EMAIL_RECIPIENT=karthikkondeboyina@gmail.com
FORCE_TEST_RECIPIENT=false

# AI Assistant & Voice Agent Configuration
# GEMINI_API_KEY=
VOICE_AGENT_ID=P2YJQU8i3wOC75sAJ3f
